# Puertos publicados por Docker Compose.
FRONTEND_PORT=3000
BACKEND_PORT=3001

# IMPORTANTE: es una variable pública de Next.js y se incrusta durante `docker compose build`.
# En un servidor remoto usa una URL que el navegador del usuario pueda alcanzar,
# por ejemplo: https://api.midominio.com o http://192.168.1.50:3001
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001
